  "sources": [
    {
      "id": "srcdjot5sn",
      "name": "EmDash CMS",
      "slug": "emdash-posts",
      "kind": "emdash",
      "url": "https://emdash-c46x.xc1.app/",
      "cmsType": "posts",
      "auth": "bearer",
      "secretVar": "EMDASH_TOKEN",
      "offline": "cache",
      "fields": [
        {
          "key": "title",
          "type": "text"
        },
        {
          "key": "featured_image",
          "type": "image"
        },
        {
          "key": "featured_image_alt",
          "type": "text"
        },
        {
          "key": "featured_image_width",
          "type": "number"
        },
        {
          "key": "featured_image_height",
          "type": "number"
        },
        {
          "key": "content",
          "type": "html"
        },
        {
          "key": "excerpt",
          "type": "text"
        },
        {
          "key": "id",
          "type": "text"
        },
        {
          "key": "slug",
          "type": "text"
        },
        {
          "key": "publishedAt",
          "type": "date"
        },
        {
          "key": "updatedAt",
          "type": "date"
        },
        {
          "key": "createdAt",
          "type": "date"
        },
        {
          "key": "author",
          "type": "text"
        },
        {
          "key": "author_slug",
          "type": "text"
        },
        {
          "key": "author_bio",
          "type": "text"
        },
        {
          "key": "authors",
          "type": "list"
        },
        {
          "key": "category",
          "type": "list"
        },
        {
          "key": "category_slugs",
          "type": "list"
        },
        {
          "key": "tag",
          "type": "list"
        },
        {
          "key": "tag_slugs",
          "type": "list"
        },
        {
          "key": "locale",
          "type": "text"
        },
        {
          "key": "translationGroup",
          "type": "text"
        },
        {
          "key": "seo",
          "type": "object"
        },
        {
          "key": "seo.title",
          "type": "text"
        },
        {
          "key": "seo.description",
          "type": "text"
        },
        {
          "key": "seo.image",
          "type": "text"
        },
        {
          "key": "seo.canonical",
          "type": "text"
        },
        {
          "key": "seo.noIndex",
          "type": "boolean"
        },
        {
          "key": "link",
          "type": "url"
        },
        {
          "key": "meta_title",
          "type": "text"
        },
        {
          "key": "meta_description",
          "type": "text"
        },
        {
          "key": "meta_image",
          "type": "image"
        },
        {
          "key": "publishedAt_text",
          "type": "text"
        },
        {
          "key": "updatedAt_text",
          "type": "text"
        },
        {
          "key": "createdAt_text",
          "type": "text"
        }
      ],
      "cmsSchema": {
        "pattern": "/posts/{slug}",
        "fields": {
          "title": "string",
          "featured_image": "image",
          "content": "portableText",
          "excerpt": "text"
        },
        "taxonomies": [
          {
            "name": "category",
            "label": "Categories"
          },
          {
            "name": "tag",
            "label": "Tags"
          }
        ]
      },
      "cmsTerms": [
        "category",
        "tag"
      ],
      "entry": {
        "on": true,
        "at": "link",
        "slugField": "slug"
      }
    }
  ],
  "media": {
    "collections": [
      {
        "id": "c-d730sa",
        "name": "Hero Images"
      }
    ],
    "assets": {
      "uploads/06-team-working.jpg": {
        "collection": "c-d730sa"
      },
      "uploads/04-project-planting.jpg": {
        "collection": "c-d730sa"
      },
      "uploads/hero-modern-home-dusk.jpg": {
        "collection": "c-d730sa"
      },
      "uploads/05-team-portrait.jpg": {
        "collection": "c-d730sa"
      },
      "uploads/garden-path-editorial.png": {
        "alt": "Illustrative landscaped garden with a stone path and layered planting"
      },
      "uploads/derwen-logo.jpg": {
        "alt": "Derwen Landscape logo"
      },
      "uploads/derwen-logo-source.webp": {
        "alt": "Derwen Landscape logo"
      }
    }
  },
  "pages": {
    "_entry-srcdjot5sn": {
      "route": "_entry-srcdjot5sn",
      "title": "{entry.meta_title}",
      "root": [
        {
          "id": "emdash-posts-entry-section",
          "tag": "section",
          "name": "Garden Journal Post",
          "classes": [
            "emdash-posts-entry"
          ],
          "attrs": {
            "builder-data-element": "section"
          },
          "children": [
            {
              "id": "emdash-posts-entry-header",
              "tag": "header",
              "name": "Post Header",
              "classes": [
                "emdash-posts-entry__header"
              ],
              "attrs": {
                "builder-data-element": "layout"
              },
              "children": [
                {
                  "tag": "div",
                  "name": "Publication Line",
                  "classes": [
                    "emdash-posts-entry__publication"
                  ],
                  "attrs": {
                    "builder-data-element": "layout"
                  },
                  "children": [
                    {
                      "tag": "span",
                      "name": "Published Label",
                      "classes": [
                        "emdash-posts-entry__publication-label"
                      ],
                      "attrs": {
                        "builder-data-element": "text"
                      },
                      "text": "Published",
                      "id": "span-mwdn738x-2740"
                    },
                    {
                      "tag": "time",
                      "name": "Published Date",
                      "classes": [
                        "emdash-posts-entry__publication-date"
                      ],
                      "attrs": {
                        "builder-data-element": "text",
                        "datetime": "{entry.publishedAt}"
                      },
                      "text": "{entry.publishedAt_text}",
                      "id": "time-mwdn738x-2741"
                    }
                  ],
                  "id": "div-mwdn738x-2739",
                  "cond": {
                    "mode": "custom",
                    "expr": "Boolean(entry.publishedAt_text)"
                  }
                },
                {
                  "id": "emdash-posts-entry-title",
                  "tag": "h1",
                  "name": "Post Title",
                  "classes": [
                    "emdash-posts-entry__title"
                  ],
                  "attrs": {
                    "builder-data-element": "heading"
                  },
                  "text": "{entry.title}"
                },
                {
                  "tag": "p",
                  "name": "Post Excerpt",
                  "classes": [
                    "emdash-posts-entry__excerpt"
                  ],
                  "attrs": {
                    "builder-data-element": "text"
                  },
                  "text": "{entry.excerpt}",
                  "id": "p-mwdn738x-2742",
                  "cond": {
                    "mode": "custom",
                    "expr": "Boolean(entry.excerpt?.trim())"
                  }
                }
              ]
            },
            {
              "id": "emdash-posts-entry-image-wrap",
              "tag": "figure",
              "name": "Post Hero",
              "classes": [
                "emdash-posts-entry__hero"
              ],
              "attrs": {
                "builder-data-element": "figure"
              },
              "children": [
                {
                  "id": "emdash-posts-entry-image",
                  "tag": "img",
                  "name": "Featured Image",
                  "classes": [
                    "emdash-posts-entry__image"
                  ],
                  "attrs": {
                    "builder-data-element": "image",
                    "src": "{entry.featured_image}",
                    "alt": "{entry.featured_image_alt || entry.title}",
                    "data-image-widths": "auto",
                    "sizes": "100vw",
                    "loading": "eager",
                    "decoding": "async"
                  }
                }
              ],
              "cond": {
                "mode": "custom",
                "expr": "Boolean(entry.featured_image)"
              }
            },
            {
              "id": "emdash-posts-entry-container",
              "tag": "div",
              "name": "Post Container",
              "classes": [
                "emdash-posts-entry__container"
              ],
              "attrs": {
                "builder-data-element": "container"
              },
              "children": [
                {
                  "id": "emdash-posts-entry-layout",
                  "tag": "div",
                  "name": "Article and Post Details",
                  "classes": [
                    "emdash-posts-entry__layout"
                  ],
                  "attrs": {
                    "builder-data-element": "layout"
                  },
                  "children": [
                    {
                      "id": "emdash-posts-entry-sidebar",
                      "tag": "aside",
                      "name": "Post Information",
                      "classes": [
                        "emdash-posts-entry__sidebar"
                      ],
                      "attrs": {
                        "builder-data-element": "layout",
                        "aria-label": "Post information"
                      },
                      "children": [
                        {
                          "tag": "div",
                          "name": "Post Author",
                          "classes": [
                            "emdash-posts-entry__meta-item"
                          ],
                          "attrs": {
                            "builder-data-element": "layout"
                          },
                          "cond": {
                            "mode": "custom",
                            "expr": "Boolean(entry.author)"
                          },
                          "children": [
                            {
                              "tag": "p",
                              "name": "Author Label",
                              "classes": [
                                "emdash-posts-entry__meta-label"
                              ],
                              "attrs": {
                                "builder-data-element": "text"
                              },
                              "text": "Written by",
                              "id": "p-mwdn738x-2744"
                            },
                            {
                              "tag": "p",
                              "name": "Author Value",
                              "classes": [
                                "emdash-posts-entry__meta-value"
                              ],
                              "attrs": {
                                "builder-data-element": "text"
                              },
                              "text": "{entry.author}",
                              "id": "p-mwdn738x-2745"
                            }
                          ],
                          "id": "div-mwdn738x-2743"
                        },
                        {
                          "tag": "div",
                          "name": "Updated Date",
                          "classes": [
                            "emdash-posts-entry__meta-item"
                          ],
                          "attrs": {
                            "builder-data-element": "layout"
                          },
                          "children": [
                            {
                              "tag": "p",
                              "name": "Updated Label",
                              "classes": [
                                "emdash-posts-entry__meta-label"
                              ],
                              "attrs": {
                                "builder-data-element": "text"
                              },
                              "text": "Updated on",
                              "id": "p-mwdn738x-2747"
                            },
                            {
                              "tag": "p",
                              "name": "Updated Value",
                              "classes": [
                                "emdash-posts-entry__meta-value"
                              ],
                              "attrs": {
                                "builder-data-element": "text"
                              },
                              "text": "{entry.updatedAt_text}",
                              "id": "p-mwdn738x-2748"
                            }
                          ],
                          "id": "div-mwdn738x-2746",
                          "cond": {
                            "mode": "custom",
                            "expr": "Boolean(entry.updatedAt_text)"
                          }
                        },
                        {
                          "tag": "div",
                          "name": "Post Categories",
                          "classes": [
                            "emdash-posts-entry__taxonomy"
                          ],
                          "attrs": {
                            "builder-data-element": "layout"
                          },
                          "cond": {
                            "mode": "custom",
                            "expr": "(entry.category?.length ?? 0) > 0"
                          },
                          "children": [
                            {
                              "tag": "h2",
                              "name": "Category Heading",
                              "classes": [
                                "emdash-posts-entry__taxonomy-title"
                              ],
                              "attrs": {
                                "builder-data-element": "heading"
                              },
                              "text": "Categories",
                              "id": "h2-mwdn738x-2750"
                            },
                            {
                              "tag": "ul",
                              "name": "Category List",
                              "classes": [
                                "emdash-posts-entry__term-list"
                              ],
                              "attrs": {
                                "builder-data-element": "list"
                              },
                              "loop": {
                                "source": "custom",
                                "custom": "entry.category",
                                "itemName": "category"
                              },
                              "children": [
                                {
                                  "tag": "li",
                                  "name": "Category Term",
                                  "classes": [
                                    "emdash-posts-entry__term"
                                  ],
                                  "attrs": {
                                    "builder-data-element": "text"
                                  },
                                  "text": "{category}",
                                  "id": "li-mwdn738x-2752"
                                }
                              ],
                              "id": "ul-mwdn738x-2751"
                            }
                          ],
                          "id": "div-mwdn738x-2749"
                        },
                        {
                          "tag": "div",
                          "name": "Post Tags",
                          "classes": [
                            "emdash-posts-entry__taxonomy"
                          ],
                          "attrs": {
                            "builder-data-element": "layout"
                          },
                          "cond": {
                            "mode": "custom",
                            "expr": "(entry.tag?.length ?? 0) > 0"
                          },
                          "children": [
                            {
                              "tag": "h2",
                              "name": "Tag Heading",
                              "classes": [
                                "emdash-posts-entry__taxonomy-title"
                              ],
                              "attrs": {
                                "builder-data-element": "heading"
                              },
                              "text": "Tags",
                              "id": "h2-mwdn738x-2754"
                            },
                            {
                              "tag": "ul",
                              "name": "Tag List",
                              "classes": [
                                "emdash-posts-entry__term-list"
                              ],
                              "attrs": {
                                "builder-data-element": "list"
                              },
                              "loop": {
                                "source": "custom",
                                "custom": "entry.tag",
                                "itemName": "tag"
                              },
                              "children": [
                                {
                                  "tag": "li",
                                  "name": "Tag Term",
                                  "classes": [
                                    "emdash-posts-entry__term"
                                  ],
                                  "attrs": {
                                    "builder-data-element": "text"
                                  },
                                  "text": "{tag}",
                                  "id": "li-mwdn738x-2756"
                                }
                              ],
                              "id": "ul-mwdn738x-2755"
                            }
                          ],
                          "id": "div-mwdn738x-2753"
                        }
                      ],
                      "cond": {
                        "mode": "custom",
                        "expr": "Boolean(entry.author || entry.updatedAt_text || entry.category?.length || entry.tag?.length)"
                      }
                    },
                    {
                      "id": "emdash-posts-entry-article",
                      "tag": "article",
                      "name": "Post Article",
                      "classes": [
                        "emdash-posts-entry__article"
                      ],
                      "attrs": {
                        "builder-data-element": "layout"
                      },
                      "children": [
                        {
                          "id": "emdash-posts-entry-content",
                          "tag": "div",
                          "name": "Post Content",
                          "classes": [
                            "emdash-posts-entry__content"
                          ],
                          "attrs": {
                            "builder-data-element": "rich-text"
                          },
                          "html": "{entry.content}",
                          "cond": {
                            "mode": "custom",
                            "expr": "Boolean(entry.content?.trim())"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "seo": {
        "description": "{entry.meta_description}"
      },
      "stylesheets": [
        {
          "id": "global",
          "name": "Global",
          "rules": [
            {
              "selector": ".emdash-posts-entry__content",
              "css": "min-inline-size: 0;"
            },
            {
              "selector": ".emdash-posts-entry",
              "css": "padding-inline: var(--site-padding); background: var(--white);"
            },
            {
              "selector": ".emdash-posts-entry__hero",
              "css": "inline-size: min(100%, var(--content-width)); margin: 0 auto; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--image-radius); background: var(--base-100);\n@media (max-width: 48rem) { aspect-ratio: 4 / 3; }"
            },
            {
              "selector": ".emdash-posts-entry__image",
              "css": "display: block; inline-size: 100%; block-size: 100%; object-fit: cover;"
            },
            {
              "selector": ".emdash-posts-entry__container",
              "css": "max-inline-size: var(--content-width); margin-inline: auto; padding-block: var(--section-space-m) var(--section-space-l);"
            },
            {
              "selector": ".emdash-posts-entry__header",
              "css": "max-inline-size: var(--content-width); margin-inline: auto; padding-block: var(--section-space-m) var(--space-l); display: grid; gap: var(--space-m);"
            },
            {
              "selector": ".emdash-posts-entry__eyebrow",
              "css": "color: var(--accent);"
            },
            {
              "selector": ".emdash-posts-entry__excerpt",
              "css": "font-size: var(--text-l);"
            },
            {
              "selector": ".emdash-posts-entry__layout",
              "css": "display: grid; grid-template-columns: minmax(13rem, 0.8fr) minmax(0, 2fr); align-items: start; gap: var(--grid-gap);\n@media (max-width: 48rem) { grid-template-columns: minmax(0, 1fr); }"
            },
            {
              "selector": ".emdash-posts-entry__article",
              "css": "min-inline-size: 0;"
            },
            {
              "selector": ".emdash-posts-entry__sidebar",
              "css": "display: grid; align-content: start; gap: var(--container-spacing); padding-inline-end: var(--space-l); border-inline-end: var(--border);\n@media (max-width: 48rem) { padding-inline-end: 0; padding-block-end: var(--space-l); border-inline-end: 0; border-block-end: var(--border); }"
            },
            {
              "selector": ".emdash-posts-entry__sidebar-title",
              "css": "font-size: var(--h4);"
            },
            {
              "selector": ".emdash-posts-entry__meta-list",
              "css": "display: grid; gap: var(--space-s); margin: 0;"
            },
            {
              "selector": ".emdash-posts-entry__meta-item",
              "css": "display: grid; gap: var(--space-xxs);"
            },
            {
              "selector": ".emdash-posts-entry__meta-label",
              "css": "color: var(--neutral-300); font-size: var(--text-s);"
            },
            {
              "selector": ".emdash-posts-entry__meta-value",
              "css": "margin: 0;"
            },
            {
              "selector": ".emdash-posts-entry__taxonomy",
              "css": "display: grid; gap: var(--space-xs);"
            },
            {
              "selector": ".emdash-posts-entry__taxonomy-title",
              "css": "font-size: var(--h5);"
            },
            {
              "selector": ".emdash-posts-entry__term-list",
              "css": "display: flex; flex-wrap: wrap; gap: var(--space-xs); padding: 0; margin: 0; list-style: none;"
            },
            {
              "selector": ".emdash-posts-entry__term",
              "css": "padding-block: var(--space-xxs); padding-inline: var(--space-xs); border-radius: var(--radius-s); background: var(--primary-10); color: var(--base);"
            },
            {
              "selector": ".emdash-posts-entry__publication",
              "css": "display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-xs); color: var(--neutral-300); font-size: var(--text-s);"
            },
            {
              "selector": ".emdash-posts-entry__publication-date",
              "css": "color: var(--text-color);"
            },
            {
              "selector": ".emdash-posts-entry__title",
              "css": "font-size: var(--h1);"
            }
          ]
        }
      ]
    },
    "_entry-srczgw0t2j": {
      "route": "_entry-srczgw0t2j",
      "title": "{entry.meta_title}",
      "root": [
        {
          "tag": "section",
