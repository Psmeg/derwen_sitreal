      "stylesheets": [
        {
          "id": "tpl-main-header",
          "name": "Main Header",
          "rules": [
            {
              "selector": ".site-header",
              "css": "padding-inline: var(--site-padding);\npadding-block: var(--space-xs);\nbackground: var(--base);\ncolor: var(--white);"
            },
            {
              "selector": ".site-header__inner",
              "css": "inline-size: min(100%, var(--content-width));\nmin-block-size: var(--section-space-s);\nmargin-inline: auto;\ndisplay: flex;\nalign-items: center;\njustify-content: space-between;"
            },
            {
              "selector": ".site-header__brand",
              "css": "display: inline-flex;\nflex-direction: row;\ngap: var(--space-xxs);\ncolor: inherit;\ntext-decoration: none;\nflex-wrap: wrap;\njustify-content: center;\nalign-items: center;\n\n&:focus-visible {\n  outline: var(--focus-width) var(--focus-style) var(--focus-color);\n  outline-offset: var(--focus-offset);\n}"
            },
            {
              "selector": ".site-nav",
              "css": "display: flex;\nalign-items: center;\ngap: var(--space-xs);\n@media (max-width: 760px) {\n  gap: var(--space-xxs);\n}"
            },
            {
              "selector": ".site-nav__link:not(.btn)",
              "css": "display: inline-flex;\nmin-block-size: var(--tap-target);\nalign-items: center;\npadding-inline: var(--space-xs);\ncolor: var(--white);\ntext-decoration: none;\ntransition: color var(--motion-duration) var(--motion-ease);\n&:hover { color: var(--base-100); }\n&:focus-visible {\n  outline: var(--focus-width) var(--focus-style) var(--focus-color);\n  outline-offset: var(--focus-offset);\n}"
            },
            {
              "selector": ".site-footer",
              "css": "padding-inline: var(--site-padding);\npadding-block: var(--section-space-s);\nbackground: var(--base);\ncolor: var(--white);"
            },
            {
              "selector": ".site-footer__inner",
              "css": "inline-size: min(100%, var(--content-width));\nmargin-inline: auto;\ndisplay: grid;\ngrid-template-columns: auto 1fr auto;\nalign-items: center;\ngap: var(--container-spacing);\n@media (max-width: 48rem) { grid-template-columns: minmax(0, 1fr); }"
            },
            {
              "selector": ".site-footer__brand",
              "css": "display: grid;\ngap: var(--space-xxs);\ncolor: inherit;\ntext-decoration: none;"
            },
            {
              "selector": ".site-footer__note",
              "css": "color: var(--white);\nfont-size: var(--text-s);"
            },
            {
              "selector": ".site-footer__nav",
              "css": "display: flex;\nflex-wrap: wrap;\ngap: var(--space-m);"
            },
            {
              "selector": ".site-footer__link",
              "css": "color: var(--white);\ntext-decoration: none;\n&:hover { color: var(--base-100); }\n&:focus-visible { outline: var(--focus-width) var(--focus-style) var(--focus-color); outline-offset: var(--focus-offset); }"
            },
            {
              "selector": ".site-header__logo",
              "css": "display: block;\ninline-size: var(--section-space-l);\nblock-size: var(--section-space-m);\nobject-fit: cover;\nfilter: grayscale(1) invert(1) contrast(3) sepia(.25) brightness(.96);\nmix-blend-mode: screen;"
            },
            {
              "selector": ".site-footer__logo",
              "css": "display: block;\ninline-size: var(--section-space-l);\nblock-size: var(--section-space-m);\nobject-fit: cover;\nfilter: grayscale(1) invert(1) contrast(3) sepia(.25) brightness(.96);\nmix-blend-mode: screen;"
            }
          ]
        }
      ],
      "applyTo": {
        "all": true
      }
    },
