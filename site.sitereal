      ],
      "stylesheets": [
        {
          "id": "global",
          "name": "Global",
          "rules": [
            {
              "selector": ".hero",
              "css": "position: relative;\ndisplay: grid;\nmin-block-size: var(--section-space-xxl);\noverflow: hidden;\nbackground: var(--base);\ncolor: var(--white);"
            },
            {
              "selector": ".hero__content",
              "css": "grid-area: 1 / 1;\nz-index: 2;\ninline-size: min(100%, var(--content-width));\nmargin-inline: auto;\npadding-inline: var(--site-padding);\npadding-block: var(--section-space-xl);\ndisplay: grid;\nalign-items: center;\n@media (max-width: 48rem) {\n  padding-block: var(--section-space-l);\n}"
            },
            {
              "selector": ".hero__headline",
              "css": "min-inline-size: 0;\ninline-size: min(70%, var(--content-width-inset));\ndisplay: grid;\njustify-items: start;\ngap: var(--space-m);\n@media (max-width: 48rem) { inline-size: 100%; }"
            },
            {
              "selector": ".hero__eyebrow",
              "css": "display: flex;\nalign-items: center;\ngap: var(--space-s);\ncolor: var(--base-100);\n&::before {\n  inline-size: var(--space-xs);\n  block-size: var(--space-xs);\n  flex: 0 0 auto;\n  border-radius: 50%;\n  background: var(--accent);\n  content: \"\";\n}"
            },
            {
              "selector": ".hero__copy",
              "css": "color: var(--white);\nfont-size: var(--text-l);"
            },
            {
              "selector": ".hero__visual",
              "css": "grid-area: 1 / 1;\nposition: relative;\nz-index: 1;\nisolation: isolate;\nmin-block-size: var(--section-space-xxl);\n&::before {\n  position: absolute;\n  z-index: 0;\n  inset: 0;\n  background: linear-gradient(90deg, var(--base-90), var(--base-40));\n  content: \"\";\n}"
            },
            {
              "selector": ".hero__figure",
              "css": "position: absolute;\nz-index: -1;\ninset: 0;\ninline-size: 100%;\nmargin: 0;"
            },
            {
              "selector": ".hero__image",
              "css": "display: block;\ninline-size: 100%;\nblock-size: 100%;\nobject-fit: cover;\nobject-position: center 55%;"
            },
            {
              "selector": ".garden-intro",
              "css": "padding-block: var(--section-space-l);\npadding-inline: var(--site-padding);\nbackground: var(--white);\ncolor: var(--neutral);"
            },
            {
              "selector": ".garden-intro__container",
              "css": "inline-size: min(100%, var(--content-width));\nmargin-inline: auto;\ndisplay: grid;\ngap: var(--section-space-m);"
            },
            {
              "selector": ".garden-intro__header",
              "css": "inline-size: min(100%, 75%);\nmargin-inline: auto;\ndisplay: grid;\njustify-items: center;\ngap: var(--space-s);\ntext-align: center;\n@media (max-width: 48rem) { inline-size: 100%; }"
            },
            {
              "selector": ".garden-intro__eyebrow",
              "css": "font-size: var(--text-s);\ncolor: var(--primary);"
            },
            {
              "selector": ".garden-intro__lead",
              "css": "font-size: var(--text-l);\ncolor: var(--text-color);"
            },
            {
              "selector": ".garden-intro__panel",
              "css": "display: grid;\ngrid-template-columns: minmax(0, 1fr);\ninline-size: 100%;"
            },
            {
              "selector": ".garden-intro__cards",
              "css": "display: grid;\ngrid-template-columns: repeat(3, minmax(0, 1fr));\nalign-items: start;\ngap: var(--grid-gap);\n@media (max-width: 48rem) { grid-template-columns: minmax(0, 1fr); }"
            },
            {
              "selector": ".garden-intro__card",
              "css": "display: block;\npadding-block: var(--space-s);\nborder: 0;\nborder-block-start: var(--border-width) solid var(--border-light);\nbackground: transparent;\ncolor: var(--neutral);\n&[open] > .garden-intro__card-heading::after { content: \"−\"; }"
            },
            {
              "selector": ".garden-intro__card-heading",
              "css": "display: grid;\ngrid-template-columns: auto minmax(0, 1fr) auto;\nalign-items: center;\ngap: var(--space-s);\nmin-block-size: var(--tap-target);\ncursor: pointer;\nlist-style: none;\n&::after { content: \"+\"; color: var(--primary); font-size: var(--h3); }\n&::-webkit-details-marker { display: none; }"
            },
            {
              "selector": ".garden-intro__card-copy",
              "css": "padding-block-start: var(--space-s);"
            },
            {
              "selector": ".garden-intro__card-title",
              "css": "font-size: var(--h5);"
            },
            {
              "selector": ".garden-work",
              "css": "padding-block: var(--section-space-l);\npadding-inline: var(--site-padding);\nbackground: var(--base-100);"
            },
            {
              "selector": ".garden-work__container",
              "css": "inline-size: min(100%, var(--content-width));\nmargin-inline: auto;\ndisplay: grid;\ngap: var(--section-space-m);"
            },
            {
              "selector": ".garden-work__header",
              "css": "inline-size: min(100%, 75%);\nmargin-inline: auto;\ndisplay: grid;\njustify-items: center;\ngap: var(--space-s);\ntext-align: center;\n@media (max-width: 48rem) { inline-size: 100%; }"
            },
            {
              "selector": ".garden-work__eyebrow",
              "css": "color: var(--primary);\nfont-size: var(--text-s);"
            },
            {
              "selector": ".garden-work__feature",
              "css": "display: grid;\ngrid-template-columns: minmax(0, 1fr);\noverflow: hidden;\nbackground: transparent;"
            },
            {
              "selector": ".garden-work__figure",
              "css": "min-inline-size: 0;\nmargin: 0;"
            },
            {
              "selector": ".garden-work__image",
              "css": "display: block;\ninline-size: 100%;\naspect-ratio: 2 / 1;\nobject-fit: cover;\nborder-radius: var(--image-radius);\n@media (max-width: 48rem) { aspect-ratio: 4 / 3; }"
            },
            {
              "selector": ".garden-work__story",
              "css": "display: grid;\ngrid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\ngap: var(--space-m);\npadding-block: var(--space-m);\n@media (max-width: 48rem) { grid-template-columns: minmax(0, 1fr); }"
            },
            {
              "selector": ".garden-work__story-eyebrow",
              "css": "grid-column: 1 / -1;\ncolor: var(--primary);\nfont-size: var(--text-s);"
            },
            {
              "selector": ".garden-work__story-title",
              "css": "font-size: var(--h3);"
            },
            {
              "selector": ".garden-work__copy",
              "css": "color: var(--text-color);"
            },
            {
              "selector": ".garden-work__link",
              "css": "color: var(--primary);\ntext-decoration: underline;\ntext-underline-offset: var(--space-xxs);\n&:hover { color: var(--accent); }\n&:focus-visible { outline: var(--focus-width) var(--focus-style) var(--focus-color); outline-offset: var(--focus-offset); }"
            },
            {
              "selector": ".garden-approach",
              "css": "padding-block: var(--section-space-l);\npadding-inline: var(--site-padding);\nbackground: var(--white);"
            },
            {
              "selector": ".garden-approach__container",
              "css": "inline-size: min(100%, var(--content-width));\nmargin-inline: auto;\ndisplay: grid;\ngap: var(--section-space-m);"
            },
            {
              "selector": ".garden-approach__header",
              "css": "inline-size: min(100%, 75%);\nmargin-inline: auto;\ndisplay: flex;\njustify-items: center;\ntext-align: center;\ngap: var(--space-s);\nflex-wrap: wrap;\nflex-direction: column;\n\n@media (max-width: 48rem) {\n  inline-size: 100%;\n}"
            },
            {
              "selector": ".garden-approach__eyebrow",
              "css": "color: var(--primary);\nfont-size: var(--text-s);"
            },
            {
              "selector": ".garden-approach__intro",
              "css": "color: var(--text-color);"
            },
            {
              "selector": ".garden-approach__list",
              "css": "display: grid;\ngrid-template-columns: repeat(3, minmax(0, 1fr));\ngap: var(--grid-gap);\nmargin: 0;\npadding: 0;\nlist-style: none;\n@media (max-width: 48rem) { grid-template-columns: minmax(0, 1fr); }"
            },
            {
              "selector": ".garden-approach__item",
              "css": "display: grid;\njustify-items: center;\nalign-content: start;\ngap: var(--space-s);\npadding: var(--space-m);\nborder: 0;\ntext-align: center;"
            },
            {
              "selector": ".garden-approach__number",
              "css": "color: var(--accent);\nfont-size: var(--h2);"
            },
            {
              "selector": ".garden-approach__item-title",
              "css": "font-size: var(--h5);"
            },
            {
              "selector": ".garden-approach__copy",
              "css": "color: var(--text-color);"
            },
            {
              "selector": ".garden-cta",
              "css": "--heading-color: var(--white);\npadding-block: var(--section-space-l);\npadding-inline: var(--site-padding);\nbackground: linear-gradient(var(--base-80), var(--base-80)), url(\"/uploads/04-project-planting.jpg\") center / cover no-repeat;\ncolor: var(--white);"
            },
            {
              "selector": ".garden-cta__container",
              "css": "inline-size: min(100%, var(--content-width));\nmargin-inline: auto;\ndisplay: grid;\ngrid-template-columns: minmax(0, 1fr);\njustify-items: center;\ngap: var(--space-l);\ntext-align: center;"
            },
            {
              "selector": ".garden-cta__content",
              "css": "display: grid;\njustify-items: center;\ngap: var(--space-s);"
            },
            {
              "selector": ".garden-cta__eyebrow",
              "css": "color: var(--base-100);\nfont-size: var(--text-s);"
            },
            {
              "selector": ".garden-cta__copy",
              "css": "color: var(--base-100);"
            },
            {
              "selector": ".hero__title",
              "css": "color: var(--white);"
            },
            {
              "selector": ".garden-intro__card-number",
              "css": "color: var(--accent);\nfont-size: var(--text-s);"
            },
            {
              "selector": ".team-section",
              "css": "padding-block: var(--section-space-l);\npadding-inline: var(--site-padding);\nbackground: var(--white);\ncolor: var(--neutral);"
            },
            {
              "selector": ".team-section__container",
              "css": "inline-size: min(100%, var(--content-width));\nmargin-inline: auto;\ndisplay: grid;\ngap: var(--section-space-m);"
            },
            {
              "selector": ".team-section__header",
              "css": "inline-size: min(100%, 75%);\nmargin-inline: auto;\ndisplay: grid;\njustify-items: center;\ngap: var(--space-s);\ntext-align: center;\n@media (max-width: 48rem) { inline-size: 100%; }"
            },
            {
              "selector": ".team-section__eyebrow",
              "css": "color: var(--primary);\nfont-size: var(--text-s);"
            },
            {
              "selector": ".team-section__intro",
              "css": "color: var(--text-color);\nfont-size: var(--text-l);"
            },
            {
              "selector": ".team-section__grid",
              "css": "display: grid;\ngrid-template-columns: repeat(3, minmax(0, 1fr));\ngrid-auto-flow: row;\ngap: var(--grid-gap);\n@media (max-width: 48rem) { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n@media (max-width: 40rem) { grid-template-columns: minmax(0, 1fr); }"
            },
            {
              "selector": ".team-card",
              "css": "display: grid;\nalign-content: start;\noverflow: hidden;\nborder: var(--border-width) solid var(--border-light);\nborder-radius: var(--radius-s);\nbackground: var(--white);\ncolor: var(--neutral);"
            },
            {
              "selector": ".team-card__figure",
              "css": "margin: 0;\naspect-ratio: 1 / 2;\noverflow: hidden;\nbackground: var(--base-100);"
            },
            {
              "selector": ".team-card__image",
              "css": "display: block;\ninline-size: 100%;\nblock-size: 100%;\nobject-fit: cover;"
            },
            {
              "selector": ".team-card__body",
              "css": "display: grid;\ngap: var(--space-xs);\npadding: var(--space-m);"
            },
            {
              "selector": ".team-card__name",
              "css": "font-size: var(--h4);"
            },
            {
              "selector": ".team-card__department",
              "css": "display: flex;\nflex-wrap: wrap;\ngap: var(--space-xxs) var(--space-xs);\ncolor: var(--primary);\nfont-size: var(--text-s);"
            },
            {
              "selector": ".hero__actions",
              "css": "display: flex;\nflex-wrap: wrap;\nalign-items: center;\ngap: var(--space-s);"
            },
            {
              "selector": ".service-showcase",
              "css": "display: grid;\ngrid-template-columns: 2fr 1fr 1fr;\ngap: var(--grid-gap);\n@media (max-width: 48rem) { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n@media (max-width: 40rem) { grid-template-columns: minmax(0, 1fr); }"
            },
            {
              "selector": ".service-showcase__card",
              "css": "--heading-color: var(--white);\nposition: relative;\ndisplay: grid;\nmin-inline-size: 0;\nmin-block-size: var(--section-space-xxl);\noverflow: hidden;\nborder-radius: var(--image-radius);\nbackground: var(--base);\ncolor: var(--white);\n&:first-child { aspect-ratio: 4 / 3; }\n&::before { position: absolute; z-index: 1; inset: 0; background: linear-gradient(0deg, var(--black-80), var(--black-10)); content: \"\"; }\n@media (max-width: 48rem) { aspect-ratio: 3 / 4; &:first-child { grid-column: 1 / -1; aspect-ratio: 16 / 9; } }\n@media (max-width: 40rem) { aspect-ratio: 4 / 3; &:first-child { grid-column: auto; aspect-ratio: 4 / 3; } }"
            },
            {
              "selector": ".service-showcase__image",
              "css": "position: absolute;\ninset: 0;\ndisplay: block;\ninline-size: 100%;\nblock-size: 100%;\nobject-fit: cover;"
            },
            {
              "selector": ".service-showcase__content",
              "css": "position: relative;\nz-index: 2;\ndisplay: grid;\nalign-self: end;\ngap: var(--space-xs);\npadding: var(--space-m);"
            },
            {
              "selector": ".service-showcase__label",
              "css": "font-size: var(--text-s);\ncolor: var(--white);"
            },
            {
              "selector": ".service-showcase__title",
              "css": "color: var(--white);\nfont-size: var(--h4);"
            },
            {
              "selector": ".service-showcase__copy",
              "css": "color: var(--white);\nfont-size: var(--text-s);"
            },
            {
              "selector": ".garden-feature",
              "css": "padding-block: var(--section-space-l);\npadding-inline: var(--site-padding);\nbackground: var(--primary-10);"
            },
            {
              "selector": ".garden-feature__container",
              "css": "inline-size: min(100%, var(--content-width));\nmargin-inline: auto;\ndisplay: grid;\ngrid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\nalign-items: center;\ngap: var(--section-space-l);\n@media (max-width: 48rem) { grid-template-columns: minmax(0, 1fr); gap: var(--section-space-s); }"
            },
            {
              "selector": ".garden-feature__visual",
              "css": "position: relative;\nmin-inline-size: 0;"
            },
            {
              "selector": ".garden-feature__image",
              "css": "display: block;\ninline-size: 80%;\naspect-ratio: 4 / 5;\nobject-fit: cover;\nborder-radius: var(--image-radius);"
            },
            {
              "selector": ".garden-feature__detail",
              "css": "position: absolute;\ninset-inline-end: 0;\ninset-block-end: var(--space-l);\ndisplay: block;\ninline-size: 45%;\naspect-ratio: 1 / 1;\nobject-fit: cover;\nborder: var(--space-xxs) solid var(--white);\nborder-radius: var(--image-radius);"
            },
            {
              "selector": ".garden-feature__content",
              "css": "display: grid;\njustify-items: start;\nalign-content: center;\ngap: var(--space-m);"
            },
            {
              "selector": ".garden-feature__eyebrow",
              "css": "color: var(--primary);\nfont-size: var(--text-s);"
            },
            {
              "selector": ".garden-feature__copy",
              "css": "color: var(--text-color);\nfont-size: var(--text-l);"
            },
            {
              "selector": ".latest-posts",
              "css": "padding-block: var(--section-space-m); padding-inline: var(--site-padding); background: var(--surface);"
            },
            {
              "selector": ".latest-posts__container",
              "css": "max-inline-size: var(--content-width); margin-inline: auto; display: grid; gap: var(--container-spacing);"
            },
            {
              "selector": ".latest-posts__header",
              "css": "display: grid; justify-items: center; text-align: center; gap: var(--space-s);"
            },
            {
              "selector": ".latest-posts__grid",
              "css": "display: grid; grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr)); gap: var(--grid-gap); @media (max-width: 48rem) { grid-template-columns: 1fr; }"
            },
            {
              "selector": ".latest-posts__card",
              "css": "position: relative; isolation: isolate; display: flex; flex-direction: column; justify-content: end; min-block-size: calc(var(--section-space-xxl) * 2); overflow: hidden; border-radius: var(--radius-m); background: var(--base); &:hover .latest-posts__image, &:focus-within .latest-posts__image { scale: 1.04; } @media (prefers-reduced-motion: reduce) { &:hover .latest-posts__image, &:focus-within .latest-posts__image { scale: 1; } }"
            },
            {
              "selector": ".latest-posts__image",
              "css": "position: absolute; z-index: -1; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; transition: scale var(--motion-duration) var(--motion-ease); @media (prefers-reduced-motion: reduce) { transition: none; }"
            },
            {
              "selector": ".latest-posts__content",
              "css": "display: flex; flex-direction: column; gap: var(--space-s); padding: var(--space-l); padding-block-start: var(--section-space-l); color: var(--white); background: linear-gradient(to top, var(--black-90), var(--black-70), transparent);"
            },
            {
              "selector": ".latest-posts__post-title",
              "css": "font-size: var(--h4); color: var(--white);"
            },
            {
              "selector": ".latest-posts__link",
              "css": "display: inline-flex; align-items: center; align-self: flex-start; gap: var(--space-xs); color: var(--white); &::after { content: ''; position: absolute; inset: 0; } &:focus-visible { outline: var(--focus-width) var(--focus-style) var(--focus-color); outline-offset: var(--focus-offset); }"
            },
            {
              "selector": ".latest-posts__arrow",
              "css": "inline-size: 1em; block-size: 1em; flex: none;"
            },
            {
              "selector": ".latest-posts__categories",
              "css": "display: flex; flex-wrap: wrap; gap: var(--space-xs); color: var(--white);"
            },
            {
              "selector": ".latest-posts__category",
              "css": "font-size: var(--text-s);"
            },
            {
              "selector": ".latest-posts__intro",
              "css": "max-inline-size: var(--content-width-inset);"
            }
          ]
        }
      ]
    },
