          "id": "global",
          "name": "Global",
          "rules": [
            {
              "selector": ".team-archive__grid",
              "css": "display: grid;\ninline-size: 100%;\ngrid-template-columns: repeat(3, minmax(0, 1fr));\ngap: var(--grid-gap);\nmargin-block-start: var(--section-space-s);\n@media (max-width: 48rem) { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n@media (max-width: 30rem) { grid-template-columns: 1fr; }"
            },
            {
              "selector": ".team-archive__card",
              "css": "display: flex;\nflex-direction: column;\nalign-items: flex-start;\ngap: var(--space-xs);\n&:hover .team-archive__image { scale: 1.02; }\n&:focus-within .team-archive__image { outline: var(--focus-width) var(--focus-style) var(--focus-color); outline-offset: var(--focus-offset); }"
            },
            {
              "selector": ".team-archive__image",
              "css": "display: block;\naspect-ratio: 1 / 1;\nobject-fit: cover;\nobject-position: center 30%;\ninline-size: 100%;\nbackground: var(--primary-100);\nborder-radius: var(--image-radius);\nmix-blend-mode: multiply;\ntransition: scale var(--motion-duration) var(--motion-ease);"
            },
            {
              "selector": ".team-archive",
              "css": "padding-block: var(--section-space-xl);\npadding-inline: var(--site-padding);\nbackground: var(--surface);"
            },
            {
              "selector": ".team-archive__container",
              "css": "display: flex;\nflex-direction: column;\nalign-items: flex-start;\nmax-inline-size: var(--content-width);\nmargin-inline: auto;\ngap: var(--content-spacing);"
            },
            {
              "selector": ".team-archive__eyebrow",
              "css": "color: var(--accent);\nfont-size: var(--text-s);"
            },
            {
              "selector": ".team-archive__heading",
              "css": "max-inline-size: var(--content-width-inset);\ncolor: var(--heading-color);"
            },
            {
              "selector": ".team-archive__intro",
              "css": "max-inline-size: 60ch;\ncolor: var(--text-color);"
            },
            {
              "selector": ".team-archive__title",
              "css": "font-size: var(--h4);"
            },
            {
              "selector": ".team-archive__link",
              "css": "color: var(--heading-color);\ntext-decoration: none;\n&:hover { color: var(--link-color-hover); }\n&:focus-visible { outline: var(--focus-width) var(--focus-style) var(--focus-color); outline-offset: var(--focus-offset); }"
            },
            {
              "selector": ".team-archive__department",
              "css": "color: var(--text-color);\nfont-size: var(--text-m);"
            }
          ]
        }
      ]
    }
  },
