      "seo": {
        "description": "{entry.meta_description}"
      },
      "stylesheets": [
        {
          "id": "global",
          "name": "Global",
          "rules": [
            {
              "selector": ".emdash-posts-entry__content",
              "css": "color: var(--text-color);\n& :is(h1, h2, h3, h4, h5, h6) { color: var(--heading-color); }\n& a { color: var(--link-color); }\n& a:hover { color: var(--accent); }\n& img, & video { border-radius: var(--image-radius); }"
            },
            {
              "selector": ".emdash-posts-entry",
              "css": "padding-block: var(--section-space-l);\npadding-inline: var(--site-padding);\nbackground: var(--white);\ncolor: var(--neutral);"
            },
            {
              "selector": ".emdash-posts-entry__container",
              "css": "inline-size: min(100%, var(--content-width));\nmargin-inline: auto;\ndisplay: grid;\ngap: var(--section-space-l);"
            },
            {
              "selector": ".emdash-posts-entry__title",
              "css": "color: var(--heading-color);\nfont-size: var(--h1);"
            },
            {
              "selector": ".emdash-posts-entry__meta",
              "css": "display: flex;\nflex-wrap: wrap;\ngap: var(--space-xs);\ncolor: var(--text-color);\nfont-size: var(--text-s);"
            },
            {
              "selector": ".emdash-posts-entry__author",
              "css": "&::before { content: \"By \"; }"
            },
            {
              "selector": ".emdash-posts-entry__image",
              "css": "display: block;\ninline-size: 100%;\naspect-ratio: 2.2 / 1;\nobject-fit: cover;\nborder-radius: var(--image-radius);"
            },
            {
              "selector": ".emdash-posts-entry__hero",
              "css": "margin: 0;\noverflow: hidden;\nborder-radius: var(--radius-s);\nborder: var(--border-width) solid var(--border-light);"
            },
            {
              "selector": ".emdash-posts-entry__layout",
              "css": "display: grid;\ngrid-template-columns: minmax(0, 0.8fr) minmax(0, 3fr) minmax(0, 1.1fr);\ngap: var(--section-space-m);\nalign-items: start;\n@media (max-width: 60rem) {\n  grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);\n}\n@media (max-width: 40rem) {\n  grid-template-columns: minmax(0, 1fr);\n}"
            },
            {
              "selector": ".emdash-posts-entry__metadata",
              "css": "display: grid;\nalign-content: start;\ngap: var(--space-l);\n@media (max-width: 40rem) {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: var(--space-m);\n}"
            },
            {
              "selector": ".emdash-posts-entry__meta-item",
              "css": "display: grid;\nalign-content: start;\ngap: var(--space-xxs);\npadding-block-end: var(--space-s);\nborder-block-end: var(--border-width) solid var(--border-light);"
            },
            {
              "selector": ".emdash-posts-entry__meta-label",
              "css": "color: var(--primary);\nfont-size: var(--text-s);"
            },
            {
              "selector": ".emdash-posts-entry__meta-value",
              "css": "color: var(--text-color);"
            },
            {
              "selector": ".emdash-posts-entry__article",
              "css": "min-inline-size: 0;\ndisplay: grid;\ngap: var(--section-space-s);"
            },
            {
              "selector": ".emdash-posts-entry__article-header",
              "css": "display: grid;\ngap: var(--space-m);\npadding-block-end: var(--section-space-s);\nborder-block-end: var(--border-width) solid var(--border-light);"
            },
            {
              "selector": ".emdash-posts-entry__excerpt",
              "css": "color: var(--text-color);\nfont-size: var(--text-l);"
            },
            {
              "selector": ".emdash-posts-entry__sidebar",
              "css": "min-inline-size: 0;\ndisplay: grid;\nalign-content: start;\ngap: var(--space-l);\npadding: var(--space-m);\nborder-radius: var(--radius-s);\nbackground: var(--base-100);\n@media (max-width: 60rem) {\n  grid-column: 1 / -1;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n@media (max-width: 40rem) { grid-template-columns: minmax(0, 1fr); }"
            },
            {
              "selector": ".emdash-posts-entry__sidebar-section",
              "css": "min-inline-size: 0;\ndisplay: grid;\nalign-content: start;\ngap: var(--space-s);\npadding-block-start: var(--space-s);\nborder-block-start: var(--border-width) solid var(--border-light);"
            },
            {
              "selector": ".emdash-posts-entry__sidebar-title",
              "css": "color: var(--primary);\nfont-size: var(--h5);"
            },
            {
              "selector": ".emdash-posts-entry__search",
              "css": "color-scheme: light;\n& input {\n  inline-size: 100%;\n  min-block-size: var(--tap-target);\n  padding-inline: var(--space-s);\n  border: var(--border-width) solid var(--border-dark);\n  border-radius: var(--radius-s);\n  background: var(--white);\n  color: var(--text-color);\n}\n& input::placeholder { color: var(--neutral-300); }\n& input:focus-visible {\n  outline: var(--focus-width) var(--focus-style) var(--focus-color);\n  outline-offset: var(--focus-offset);\n}"
            },
            {
              "selector": ".emdash-posts-entry__term-list",
              "css": "display: flex;\nflex-wrap: wrap;\ngap: var(--space-xs);"
            },
            {
              "selector": ".emdash-posts-entry__term",
              "css": "padding-block: var(--space-xxs);\npadding-inline: var(--space-xs);\nborder: var(--border-width) solid var(--border-light);\nborder-radius: var(--radius-s);\nbackground: var(--white);\ncolor: var(--text-color);"
            },
            {
              "selector": ".emdash-posts-entry__empty",
              "css": "color: var(--text-color);\nfont-size: var(--text-s);"
            },
            {
              "selector": ".emdash-posts-entry__recent-list",
              "css": "display: grid;\ngap: var(--space-s);\npadding: 0;\nlist-style: none;"
            },
            {
              "selector": ".emdash-posts-entry__sidebar-link",
              "css": "color: var(--link-color);\ntext-decoration: none;\n&:hover { color: var(--accent); }\n&:focus-visible {\n  outline: var(--focus-width) var(--focus-style) var(--focus-color);\n  outline-offset: var(--focus-offset);\n}"
            }
          ]
        }
      ]
    },
    "index": {
      "route": "index",
      "title": "Home",
      "seo": {
        "description": "Thoughtful garden design shaped around your home and the way you love to spend time outside."
      },
      "js": "",
      "root": [
        {
          "id": "hero-section",
          "tag": "section",
          "name": "Hero",
          "classes": [
            "hero"
          ],
          "attrs": {
            "builder-data-element": "section",
            "id": "home-hero",
            "aria-labelledby": "hero-title"
          },
          "children": [
            {
              "id": "hero-content",
              "tag": "div",
              "classes": [
                "hero__content"
              ],
              "attrs": {
                "builder-data-element": "div",
                "data-motion": "rise",
                "data-motion-trigger": "load",
                "data-motion-stagger": "500"
              },
              "children": [
                {
                  "id": "hero-headline",
                  "tag": "div",
                  "classes": [
                    "hero__headline"
                  ],
                  "attrs": {
                    "builder-data-element": "div",
                    "data-motion": "fade",
                    "data-motion-trigger": "load"
                  },
                  "children": [
                    {
                      "id": "hero-eyebrow",
                      "tag": "p",
                      "classes": [
                        "hero__eyebrow"
                      ],
                      "attrs": {
                        "builder-data-element": "text"
                      },
                      "text": "Landscape design for living",
                      "name": "Eyebrow"
                    },
                    {
                      "id": "hero-title",
                      "tag": "h1",
                      "classes": [
                        "hero__title"
                      ],
                      "attrs": {
                        "builder-data-element": "heading",
                        "id": "hero-title"
                      },
                      "text": "CREATE A GARDEN<br>MADE FOR LIVING",
                      "name": "Hero Title"
