---
// generated by sitereal — a picture bound to data (`{post.cover}`)
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
const pictures = import.meta.glob('../../../public/**/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}', { eager: true, import: 'default' }) as Record<string, ImageMetadata>;
/** The picture under public/ an address names, imported — or nothing. An
    Astro collection's `image()` field is already imported, and is used as it is. */
const find = (src: any): ImageMetadata | undefined => {
  if (src && typeof src === 'object' && typeof src.src === 'string' && src.width) return src;
  if (typeof src !== 'string' || !src.startsWith('/') || src.startsWith('//')) return undefined;
  let path = src.replace(/^\/+/, '');
  try { path = decodeURIComponent(path); } catch {}
  return pictures['../../../public/' + path];
};
const { src, sizing, resolution, quality, remoteSrcset, remoteWidth, remoteHeight, ...attrs } = Astro.props;
const found = find(src);
/* The entry's own resolution wins only when it chose one; `auto` defers. */
const size = resolution === 'original' ? {} : typeof resolution === 'number' && resolution > 0 ? { width: resolution } : sizing;
/* What a remote picture's row says about itself, where it says it. */
const remote = {
  ...(remoteSrcset ? { srcset: remoteSrcset } : {}),
  ...(remoteWidth ? { width: remoteWidth } : {}),
  ...(remoteHeight ? { height: remoteHeight } : {}),
};
---
{found ? <Image src={found} {...size} {...(quality ? { quality } : {})} {...attrs} /> : src ? <img src={src} {...remote} {...attrs} /> : null}
