---
// generated by sitereal — entry pages for "EmDash posts"
import { emdashPosts } from "../data/sources/emdash-posts.js";
import { servicesRows } from "../db";
export async function getStaticPaths() {
  /* Addresses that are already somebody's: the pages of the project, and the entries of Services. */
  const taken = new Set(["/index","/posts","/search","/services","/services-2","/team","/404"]);
  for (const rows of [await servicesRows()] as Record<string, any>[][]) {
    for (const row of rows) if (typeof row?.url === 'string') taken.add(row.url);
  }
  const paths = [];
  for (const entry of (await emdashPosts()) as Record<string, any>[]) {
    if (typeof entry?.url !== 'string' || !entry.url.startsWith("/")) continue;
    if (taken.has(entry.url)) {
      console.warn("EmDash posts: " + entry.url + ' is already in use — no page was made for this entry.');
      continue;
    }
    taken.add(entry.url);
    paths.push({ params: { emdashPosts: entry.url.slice(1) }, props: { entry } });
  }
  return paths;
}
const { entry } = Astro.props;
import Base from '../layouts/PlainBase.astro';
import MainLayout from '../layouts/MainLayout.astro';
import SiterealRichText from '../components/sitereal/RichText.astro';
import SiterealImage from '../components/sitereal/Image.astro';
import '../styles/generated/framework.css';
import '../styles/generated/global.css';
import '../styles/generated/templates/tpl-muwmgdfe-1.css';
import '../styles/generated/pages/_entry-srczgw0t2j.css';
let emdashposts3Entries: Record<string, any>[] = [...(await emdashPosts())];
emdashposts3Entries = emdashposts3Entries.slice(0, 3);
---
<Base title={entry.meta_title} description={entry.meta_description} siteName="Derwen Landscape" lang="en">
  <Fragment slot="head">
    <link rel="icon" href="/favicon.svg?v=71b5bc0159" type="image/svg+xml" />
    <meta property="og:locale" content="en" />
    <meta name="author" content="Derwen Landscape" />
  </Fragment>
  <MainLayout>
    <section class="emdash-posts-entry" builder-data-element="section">
      <div class="emdash-posts-entry__container" builder-data-element="container">
        {(entry.featured_image) && (
          <figure class="emdash-posts-entry__hero" builder-data-element="figure">
            <SiterealImage src={entry.featured_image} sizing={{ widths: [480, 768, 1200, 1600, 2000] }} resolution={entry?.featured_image_resolution} remoteSrcset={entry?.featured_image_srcset || undefined} remoteWidth={entry?.featured_image_width || undefined} remoteHeight={entry?.featured_image_height || undefined} class="emdash-posts-entry__image" builder-data-element="image" alt={entry.title} sizes="100vw" loading="eager" fetchpriority="high" decoding="async" style={entry?.featured_image_focus ? `object-position: ${entry?.featured_image_focus}` : undefined} />
          </figure>
        )}
        <div class="emdash-posts-entry__layout" builder-data-element="div">
          <aside class="emdash-posts-entry__metadata" builder-data-element="aside" aria-label="Post metadata">
            <div class="emdash-posts-entry__meta-item" builder-data-element="div">
              <p class="emdash-posts-entry__meta-label" builder-data-element="text">Published</p>
              <time class="emdash-posts-entry__meta-value" builder-data-element="text" datetime={entry.publishedAt}>{entry.publishedAt_text}</time>
            </div>
            {(entry.author) && (
              <div class="emdash-posts-entry__meta-item" builder-data-element="div">
                <p class="emdash-posts-entry__meta-label" builder-data-element="text">Author</p>
                <p class="emdash-posts-entry__meta-value" builder-data-element="text">{entry.author}</p>
              </div>
            )}
          </aside>
          <article class="emdash-posts-entry__article" builder-data-element="article">
            <header class="emdash-posts-entry__article-header" builder-data-element="header">
              <h1 class="emdash-posts-entry__title" builder-data-element="heading">{entry.title}</h1>
              <p class="emdash-posts-entry__excerpt" builder-data-element="text">{entry.excerpt}</p>
            </header>
            <div class="emdash-posts-entry__content" builder-data-element="rich-text"><SiterealRichText html={entry.content} /></div>
          </article>
          <aside class="emdash-posts-entry__sidebar" builder-data-element="aside" aria-label="Post sidebar">
            <section class="emdash-posts-entry__sidebar-section" builder-data-element="section" aria-labelledby="post-sidebar-search-title">
              <h2 class="emdash-posts-entry__sidebar-title" builder-data-element="heading">Search</h2>
              <search class="emdash-posts-entry__search" builder-data-element="search" data-search-style="icon" data-search-part="search">
                <input builder-data-element="form-input" type="search" data-search-part="input" name="q" placeholder="Search…" aria-label="Search" autocomplete="off" />
                <div builder-data-element="search-results" hidden="" data-search-part="results">
                  <a builder-data-element="search-hit" data-result-href="{result.url}" data-search-part="hit" hidden="">
                    <span builder-data-element="search-hit-title" data-search-part="hit-title">&#123;result.title&#125;</span>
                    <span builder-data-element="search-hit-type" data-search-part="hit-type">&#123;result.type&#125;</span>
                    <span builder-data-element="search-hit-excerpt" data-search-part="hit-excerpt">&#123;result.excerpt&#125;</span>
                  </a>
                </div>
              </search>
            </section>
            <section class="emdash-posts-entry__sidebar-section" builder-data-element="section" aria-labelledby="post-sidebar-categories-title">
              <h2 class="emdash-posts-entry__sidebar-title" builder-data-element="heading">Categories</h2>
              <div class="emdash-posts-entry__term-list" builder-data-element="div">
                {((entry.category ?? []) as any[]).map((term) => (
                  <span class="emdash-posts-entry__term" builder-data-element="text">{term}</span>
                ))}
              </div>
              {(!entry.category || entry.category.length === 0) && (
                <p class="emdash-posts-entry__empty" builder-data-element="text">No categories yet</p>
              )}
            </section>
            <section class="emdash-posts-entry__sidebar-section" builder-data-element="section" aria-labelledby="post-sidebar-tags-title">
              <h2 class="emdash-posts-entry__sidebar-title" builder-data-element="heading">Tags</h2>
              <div class="emdash-posts-entry__term-list" builder-data-element="div">
                {((entry.tag ?? []) as any[]).map((term) => (
                  <span class="emdash-posts-entry__term" builder-data-element="text">{term}</span>
                ))}
              </div>
              {(!entry.tag || entry.tag.length === 0) && (
                <p class="emdash-posts-entry__empty" builder-data-element="text">No tags yet</p>
              )}
            </section>
            <section class="emdash-posts-entry__sidebar-section" builder-data-element="section" aria-labelledby="post-sidebar-recent-title">
              <h2 class="emdash-posts-entry__sidebar-title" builder-data-element="heading">Recent posts</h2>
              <ul class="emdash-posts-entry__recent-list" builder-data-element="ul">
                {emdashposts3Entries.map((item) => (
                  <li class="emdash-posts-entry__recent-item" builder-data-element="li">
                    <a class="emdash-posts-entry__sidebar-link" builder-data-element="link" href={item.url}>{item.title}</a>
                  </li>
                ))}
              </ul>
            </section>
            <section class="emdash-posts-entry__sidebar-section" builder-data-element="section" aria-labelledby="post-sidebar-archives-title">
              <h2 class="emdash-posts-entry__sidebar-title" builder-data-element="heading">Archives</h2>
              <a class="emdash-posts-entry__sidebar-link" builder-data-element="link" href="/posts">Browse all posts</a>
            </section>
          </aside>
        </div>
      </div>
    </section>
  </MainLayout>
  <script is:inline src="/scripts/nav.js" defer></script>
  <script is:inline src="/scripts/search.js" defer></script>
</Base>
