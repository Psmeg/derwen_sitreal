---
// generated by sitereal — entry pages for "EmDash CMS"
import { emdashPosts } from "../data/sources/emdash-posts.js";
import teamRows from "../data/team.json";
export async function getStaticPaths() {
  /* Addresses that are already somebody's: the pages of the project, and the entries of Team. */
  const taken = new Set(["/index","/search","/team","/team-2","/404"]);
  for (const rows of [teamRows] as Record<string, any>[][]) {
    for (const row of rows) if (typeof row?.url === 'string') taken.add(row.url);
  }
  const paths = [];
  for (const entry of (await emdashPosts()) as Record<string, any>[]) {
    if (typeof entry?.url !== 'string' || !entry.url.startsWith("/")) continue;
    if (taken.has(entry.url)) {
      console.warn("EmDash CMS: " + entry.url + ' is already in use — no page was made for this entry.');
      continue;
    }
    taken.add(entry.url);
    paths.push({ params: { emdashPosts: entry.url.slice(1) }, props: { entry } });
  }
  return paths;
}
const { entry } = Astro.props;
import Base from '../layouts/PlainBase.astro';
import MainLayout from '../layouts/MainLayout.astro';
import SiterealRichText from '../components/sitereal/RichText.astro';
import SiterealImage from '../components/sitereal/Image.astro';
import '../styles/generated/framework.css';
import '../styles/generated/global.css';
import '../styles/generated/templates/tpl-muwmgdfe-1.css';
import '../styles/generated/pages/_entry-srcdjot5sn.css';
---
<Base title={entry.meta_title} description={entry.meta_description} siteName="Derwen Landscape" lang="en">
  <Fragment slot="head">
    <link rel="icon" href="/favicon.svg?v=71b5bc0159" type="image/svg+xml" />
    <meta property="og:locale" content="en" />
    <meta name="author" content="Derwen Landscape" />
  </Fragment>
  <MainLayout>
    <section class="emdash-posts-entry" builder-data-element="section">
      <header class="emdash-posts-entry__header" builder-data-element="layout">
        {(Boolean(entry.publishedAt_text)) && (
          <div class="emdash-posts-entry__publication" builder-data-element="layout">
            <span class="emdash-posts-entry__publication-label" builder-data-element="text">Published</span>
            <time class="emdash-posts-entry__publication-date" builder-data-element="text" datetime={entry.publishedAt}>{entry.publishedAt_text}</time>
          </div>
        )}
        <h1 class="emdash-posts-entry__title" builder-data-element="heading">{entry.title}</h1>
        {(Boolean(entry.excerpt?.trim())) && (
          <p class="emdash-posts-entry__excerpt" builder-data-element="text">{entry.excerpt}</p>
        )}
      </header>
      {(Boolean(entry.featured_image)) && (
        <figure class="emdash-posts-entry__hero" builder-data-element="figure">
          <SiterealImage src={entry.featured_image} sizing={{ widths: [480, 768, 1200, 1600, 2000] }} resolution={entry?.featured_image_resolution} remoteSrcset={entry?.featured_image_srcset || undefined} remoteWidth={entry?.featured_image_width || undefined} remoteHeight={entry?.featured_image_height || undefined} class="emdash-posts-entry__image" builder-data-element="image" alt={entry.featured_image_alt || entry.title} sizes="100vw" loading="eager" decoding="async" style={entry?.featured_image_focus ? `object-position: ${entry?.featured_image_focus}` : undefined} />
        </figure>
      )}
      <div class="emdash-posts-entry__container" builder-data-element="container">
        <div class="emdash-posts-entry__layout" builder-data-element="layout">
          {(Boolean(entry.author || entry.updatedAt_text || entry.category?.length || entry.tag?.length)) && (
            <aside class="emdash-posts-entry__sidebar" builder-data-element="layout" aria-label="Post information">
              {(Boolean(entry.author)) && (
                <div class="emdash-posts-entry__meta-item" builder-data-element="layout">
                  <p class="emdash-posts-entry__meta-label" builder-data-element="text">Written by</p>
                  <p class="emdash-posts-entry__meta-value" builder-data-element="text">{entry.author}</p>
                </div>
              )}
              {(Boolean(entry.updatedAt_text)) && (
                <div class="emdash-posts-entry__meta-item" builder-data-element="layout">
                  <p class="emdash-posts-entry__meta-label" builder-data-element="text">Updated on</p>
                  <p class="emdash-posts-entry__meta-value" builder-data-element="text">{entry.updatedAt_text}</p>
                </div>
              )}
              {((entry.category?.length ?? 0) > 0) && (
                <div class="emdash-posts-entry__taxonomy" builder-data-element="layout">
                  <h2 class="emdash-posts-entry__taxonomy-title" builder-data-element="heading">Categories</h2>
                  <ul class="emdash-posts-entry__term-list" builder-data-element="list">
                    {((entry.category ?? []) as any[]).map((category) => (
                      <li class="emdash-posts-entry__term" builder-data-element="text">{category}</li>
                    ))}
                  </ul>
                </div>
              )}
              {((entry.tag?.length ?? 0) > 0) && (
                <div class="emdash-posts-entry__taxonomy" builder-data-element="layout">
                  <h2 class="emdash-posts-entry__taxonomy-title" builder-data-element="heading">Tags</h2>
                  <ul class="emdash-posts-entry__term-list" builder-data-element="list">
                    {((entry.tag ?? []) as any[]).map((tag) => (
                      <li class="emdash-posts-entry__term" builder-data-element="text">{tag}</li>
                    ))}
                  </ul>
                </div>
              )}
            </aside>
          )}
          <article class="emdash-posts-entry__article" builder-data-element="layout">
            {(Boolean(entry.content?.trim())) && (
              <div class="emdash-posts-entry__content" builder-data-element="rich-text"><SiterealRichText html={entry.content} /></div>
            )}
          </article>
        </div>
      </div>
    </section>
  </MainLayout>
  <script is:inline src="/scripts/nav.js" defer></script>
</Base>
