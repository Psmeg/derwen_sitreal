---
import Base from '../layouts/PlainBase.astro';
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/generated/framework.css';
import '../styles/generated/global.css';
import '../styles/generated/templates/tpl-muwmgdfe-1.css';
import '../styles/generated/pages/services-2.css';
import { servicesRows } from "../db";
let servicesEntries: Record<string, any>[] = await servicesRows();
servicesEntries = servicesEntries.slice().sort((a, b) => -1 * ((x, y) => typeof x === 'number' && typeof y === 'number' ? x - y : ((x) => x instanceof Date ? x.toISOString() : String(x ?? ''))(x).localeCompare(((x) => x instanceof Date ? x.toISOString() : String(x ?? ''))(y)))((a.data?.created ?? a.created), (b.data?.created ?? b.created)));
---
<Base title="Services" siteName="Derwen Landscape" lang="en">
  <Fragment slot="head">
    <link rel="icon" href="/favicon.svg?v=71b5bc0159" type="image/svg+xml" />
    <meta property="og:locale" content="en" />
    <meta name="author" content="Derwen Landscape" />
  </Fragment>
  <MainLayout>
    <section class="services-archive" builder-data-element="section">
      <div builder-data-element="container">
        <h1 class="services-archive__heading" builder-data-element="heading">Services</h1>
        <div class="services-archive__grid" builder-data-element="div">
          {servicesEntries.map((item) => (
            <article class="services-archive__card" builder-data-element="div">
              <h2 class="services-archive__title" builder-data-element="heading">
                <a class="services-archive__link" builder-data-element="link" href={item.url}>{item.title}</a>
              </h2>
            </article>
          ))}
        </div>
      </div>
    </section>
  </MainLayout>
  <script is:inline src="/scripts/nav.js" defer></script>
</Base>
