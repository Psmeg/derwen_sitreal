---
// generated by sitereal — entry pages for "Services"
import { servicesRows } from "../../db";
export async function getStaticPaths() {
  /* Addresses that are already somebody's: the project's own pages. */
  const taken = new Set();
  const paths = [];
  for (const entry of (await servicesRows()) as Record<string, any>[]) {
    const url = typeof entry?.url === 'string' ? entry.url : typeof entry?.slug === 'string' && entry.slug ? "/services/" + entry.slug : null;
    if (!url || !url.startsWith("/services/") || url.length <= 10) continue;
    if (taken.has(url)) {
      console.warn("Services: " + url + ' is already in use — no page was made for this entry.');
      continue;
    }
    taken.add(url);
    paths.push({ params: { servicesEntry: url.slice(10) }, props: { entry } });
  }
  return paths;
}
const { entry } = Astro.props;
import Base from '../../layouts/PlainBase.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import SiterealRichText from '../../components/sitereal/RichText.astro';
import '../../styles/generated/framework.css';
import '../../styles/generated/global.css';
import '../../styles/generated/templates/tpl-muwmgdfe-1.css';
---
<Base title={entry.title} siteName="Derwen Landscape" lang="en">
  <Fragment slot="head">
    <link rel="icon" href="/favicon.svg?v=71b5bc0159" type="image/svg+xml" />
    <meta property="og:locale" content="en" />
    <meta name="author" content="Derwen Landscape" />
  </Fragment>
  <MainLayout>
    <section class="services-entry" builder-data-element="section">
      <div builder-data-element="container">
        <h1 class="services-entry__title" builder-data-element="heading">{entry.title}</h1>
        <div class="services-entry__content" builder-data-element="rich-text"><SiterealRichText html={entry.service_description} /></div>
      </div>
    </section>
  </MainLayout>
  <script is:inline src="/scripts/nav.js" defer></script>
</Base>
