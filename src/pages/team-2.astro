---
import Base from '../layouts/PlainBase.astro';
import MainLayout from '../layouts/MainLayout.astro';
import SiterealImage from '../components/sitereal/Image.astro';
import '../styles/generated/framework.css';
import '../styles/generated/global.css';
import '../styles/generated/templates/tpl-muwmgdfe-1.css';
import '../styles/generated/pages/team-2.css';
import teamEntriesData from "../data/team.json";
let teamEntries: Record<string, any>[] = teamEntriesData;
teamEntries = teamEntries.slice().sort((a, b) => -1 * ((x, y) => typeof x === 'number' && typeof y === 'number' ? x - y : ((x) => x instanceof Date ? x.toISOString() : String(x ?? ''))(x).localeCompare(((x) => x instanceof Date ? x.toISOString() : String(x ?? ''))(y)))((a.data?.created ?? a.created), (b.data?.created ?? b.created)));
---
<Base title="Team" siteName="Derwen Landscape" lang="en">
  <Fragment slot="head">
    <link rel="icon" href="/favicon.svg?v=71b5bc0159" type="image/svg+xml" />
    <meta property="og:locale" content="en" />
    <meta name="author" content="Derwen Landscape" />
  </Fragment>
  <MainLayout>
    <section class="team-archive" builder-data-element="section">
      <div class="team-archive__container" builder-data-element="container">
        <p class="team-archive__eyebrow" builder-data-element="text">OUR PEOPLE</p>
        <h1 class="team-archive__heading" builder-data-element="heading">Meet the people behind Derwen.</h1>
        <p class="team-archive__intro" builder-data-element="text">A considered garden comes together through good ideas, skilled hands and a shared respect for the landscape. Meet the people who bring that work to life.</p>
        <div class="team-archive__grid" builder-data-element="div">
          {teamEntries.map((item) => (
            <article class="team-archive__card clickable-parent" builder-data-element="div">
              <SiterealImage src={item.headshot} sizing={{ widths: [480, 768, 1200, 1600, 2000] }} resolution={item?.headshot_resolution} remoteSrcset={item?.headshot_srcset || undefined} remoteWidth={item?.headshot_width || undefined} remoteHeight={item?.headshot_height || undefined} class="team-archive__image" builder-data-element="image" alt={item.headshot_alt} sizes="(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw" loading="lazy" decoding="async" style={item?.headshot_focus ? `object-position: ${item?.headshot_focus}` : undefined} />
              <h2 class="team-archive__title" builder-data-element="heading">
                <a class="team-archive__link clickable-link" builder-data-element="link" href={item.url}>{item.title}</a>
              </h2>
              <p class="team-archive__department" builder-data-element="text">{item.department}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </MainLayout>
  <script is:inline src="/scripts/nav.js" defer></script>
</Base>
