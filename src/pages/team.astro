---
import Base from '../layouts/PlainBase.astro';
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/generated/framework.css';
import '../styles/generated/global.css';
import '../styles/generated/templates/tpl-muwmgdfe-1.css';
import '../styles/generated/pages/team.css';
---
<Base title="Team" siteName="Derwen Landscape" lang="en">
  <Fragment slot="head">
    <link rel="icon" href="/favicon.svg?v=71b5bc0159" type="image/svg+xml" />
    <meta property="og:locale" content="en" />
    <meta name="author" content="Derwen Landscape" />
  </Fragment>
  <MainLayout>
    <section class="team-archive" builder-data-element="section">
      <div builder-data-element="container">
        <h1 class="team-archive__heading" builder-data-element="heading">Team</h1>
        <div class="team-archive__grid" builder-data-element="div"></div>
      </div>
    </section>
  </MainLayout>
  <script is:inline src="/scripts/nav.js" defer></script>
</Base>
