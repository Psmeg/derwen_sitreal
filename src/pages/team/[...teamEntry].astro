---
// generated by sitereal — entry pages for "Team"
import teamRows from "../../data/team.json";
export async function getStaticPaths() {
  /* Addresses that are already somebody's: the project's own pages. */
  const taken = new Set();
  const paths = [];
  for (const entry of teamRows as Record<string, any>[]) {
    const url = typeof entry?.url === 'string' ? entry.url : typeof entry?.slug === 'string' && entry.slug ? "/team/" + entry.slug : null;
    if (!url || !url.startsWith("/team/") || url.length <= 6) continue;
    if (taken.has(url)) {
      console.warn("Team: " + url + ' is already in use — no page was made for this entry.');
      continue;
    }
    taken.add(url);
    paths.push({ params: { teamEntry: url.slice(6) }, props: { entry } });
  }
  return paths;
}
const { entry } = Astro.props;
import Base from '../../layouts/PlainBase.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import SiterealImage from '../../components/sitereal/Image.astro';
import '../../styles/generated/framework.css';
import '../../styles/generated/global.css';
import '../../styles/generated/templates/tpl-muwmgdfe-1.css';
---
<Base title={entry.title} siteName="Derwen Landscape" lang="en">
  <Fragment slot="head">
    <link rel="icon" href="/favicon.svg?v=71b5bc0159" type="image/svg+xml" />
    <meta property="og:locale" content="en" />
    <meta name="author" content="Derwen Landscape" />
  </Fragment>
  <MainLayout>
    <section class="team-entry" builder-data-element="section">
      <div builder-data-element="container">
        <h1 class="team-entry__title" builder-data-element="heading">{entry.title}</h1>
        <SiterealImage src={entry.headshot} sizing={{ widths: [480, 768, 1200, 1600, 2000] }} resolution={entry?.headshot_resolution} remoteSrcset={entry?.headshot_srcset || undefined} remoteWidth={entry?.headshot_width || undefined} remoteHeight={entry?.headshot_height || undefined} class="team-entry__image" builder-data-element="image" sizes="100vw" alt={entry?.headshot_alt ?? ''} style={entry?.headshot_focus ? `object-position: ${entry?.headshot_focus}` : undefined} />
      </div>
    </section>
  </MainLayout>
  <script is:inline src="/scripts/nav.js" defer></script>
</Base>
